{
  "name": "@woo-notes/sync-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Woo 笔记的 Cloudflare Workers + D1 端到端加密同步服务",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply woo-sync --local",
    "db:migrate:remote": "wrangler d1 migrations apply woo-sync --remote",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "wrangler": "^4.0.0"
  }
}
